#!/bin/bash
# Drive YouTube Studio in the user's running Chrome over DevTools.
# Needs "Allow remote debugging for this browser instance" on at
# chrome://inspect/#remote-debugging. Never opens a separate Chrome.
#
#   yt-chrome "<agent-browser cmd>" ["<cmd>" ...]
#
# Every call switches to the Studio tab for the AI;DR channel (opening one
# if missing) and runs the commands as one batch.
set -euo pipefail
CHANNEL="${YT_CHANNEL:-UCGDB5uD8znydgMg2XLOj04w}"
STUDIO="https://studio.youtube.com/channel/$CHANNEL/videos/upload"
PORT_FILE="$HOME/Library/Application Support/Google/Chrome/DevToolsActivePort"
if [[ ! -f "$PORT_FILE" ]]; then
  echo "Chrome remote debugging is off: enable it at chrome://inspect/#remote-debugging" >&2
  exit 2
fi
WS="ws://127.0.0.1:$(sed -n 1p "$PORT_FILE")$(sed -n 2p "$PORT_FILE")"
ab() { timeout 180 agent-browser --cdp "$WS" "$@"; }
find_tab() { ab tab list 2>/dev/null | grep -m1 -E "studio.youtube.com/(channel/$CHANNEL|video/)" | grep -o '\[t[0-9]*\]' | tr -d '[]' || true; }
TAB=$(find_tab)
if [[ -z "$TAB" ]]; then
  ab tab new "$STUDIO" >/dev/null
  sleep 8
  TAB=$(find_tab)
fi
[[ -n "$TAB" ]] || { echo "no Studio tab for channel $CHANNEL (signed in to the right account?)" >&2; exit 3; }
ab batch --bail "tab $TAB" "$@"
