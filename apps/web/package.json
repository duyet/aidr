{
  "name": "@aidr/web",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "pack-extension": "tsx scripts/pack-extension.ts",
    "pack-cws": "tsx scripts/pack-cws.ts",
    "dev": "pnpm run pack-extension && vite dev --port 3014",
    "build": "pnpm run pack-extension && vite build && tsx scripts/assert-clerk-proxy-config.ts",
    "check:migrations": "pnpm run check:migration-order && tsx scripts/check-migrations.ts",
    "check:migration-order": "tsx scripts/check-migrations.ts --local-order",
    "check:migration-ledger": "tsx scripts/check-migrations.ts --ledger-order",
    "test": "vitest run",
    "test:workerd:clerk-proxy": "tsx scripts/clerk-proxy-workerd-smoke.ts",
    "test:workerd:story-og": "tsx scripts/story-og-workerd-smoke.ts",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint:fix": "biome check --write .",
    "d1:migrate": "pnpm run check:migration-ledger && pnpm exec wrangler d1 migrations apply aidr --config wrangler.toml --remote",
    "verify:translation-schema": "tsx scripts/verify-translation-schema.ts",
    "deploy": "pnpm run check:migrations && pnpm run verify:translation-schema && pnpm run build && pnpm exec wrangler deploy --config dist/server/wrangler.json",
    "cf:deploy:prod": "dotenvx run -f ../../.env.production -f ../../.env.production.local --ignore=MISSING_ENV_FILE -- pnpm run deploy && pnpm run smoke",
    "config": "tsx ../../scripts/sync-env.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@aidr/libs": "workspace:*",
    "@aidr/ui": "workspace:*",
    "@cf-wasm/og": "^0.5.0",
    "@clerk/tanstack-react-start": "^1.5.12",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.16.0",
    "motion": "^13.1.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@aidr/tsconfig": "workspace:*",
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "5.20260926.1",
    "@dotenvx/dotenvx": "^2.28.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "16.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "20.14.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20260918.0-alpha",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "*",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.135.0"
  }
}
