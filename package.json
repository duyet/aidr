{
  "name": "aidr",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm --filter @aidr/web dev",
    "build": "pnpm --filter @aidr/web build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check-types": "pnpm --filter @aidr/web check-types",
    "deploy": "pnpm --filter @aidr/web run deploy",
    "cf:deploy:prod": "pnpm --filter @aidr/web cf:deploy:prod",
    "sync-env": "pnpm --filter @aidr/web exec tsx ../../scripts/sync-env.ts",
    "config": "pnpm sync-env"
  }
}
