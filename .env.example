# aidr / AI;DR — copy to .env / .env.local / .env.production.local
# Keys only here. Put real values in gitignored env files, then:
#   pnpm sync-env              # GitHub Actions + Cloudflare Worker
#   pnpm sync-env --dry-run
#   pnpm sync-env --workers    # Worker only
#   pnpm sync-env --github     # GitHub only

# --- Clerk (client + Worker) ---
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# FAPI proxy (required on Cloudflare — clerk.aidr.today CNAME hits Error 1000).
# This is the single canonical public proxy URL. HTTPS is required; HTTP is
# allowed only for explicit loopback development (for example,
# http://localhost:3014/__clerk). Vite derives its browser value from this
# variable; never configure VITE_CLERK_PROXY_URL separately or derive this
# from request Host/forwarded-host headers.
CLERK_PROXY_URL=https://aidr.today/__clerk
# Optional upstream timeout in milliseconds (covers fetch and response body;
# handler caps this value). Clerk proxy request/response bodies are capped at
# 1 MiB.
CLERK_PROXY_TIMEOUT_MS=10000
# Webhook signing secret (Svix) for the user.created/updated/deleted endpoint at
# POST /api/webhooks/clerk, which mirrors Clerk accounts into D1 for the /data
# signups metric. Copy it from Clerk → Webhooks → your endpoint's Signing Secret
# (starts with `whsec_`). Without it the endpoint answers 503 and signups stay
# "Unavailable" until the admin backfill has run.
CLERK_WEBHOOK_SECRET=
# Optional route hints (Clerk TanStack SDK; also used by `clerk init`)
# CLERK_SIGN_IN_URL=/sign-in
# CLERK_SIGN_UP_URL=/sign-up
# VITE_CLERK_SIGN_IN_URL=/sign-in
# VITE_CLERK_SIGN_UP_URL=/sign-up

# --- LLM (AnyRouter) ---
# ANYROUTER_BASE_URL may live in wrangler.toml [vars] instead of a secret.
ANYROUTER_API_KEY=
ANYROUTER_BASE_URL=
# Explicit generator for real VI→EN candidate creation.
# ANYROUTER_ENGLISH_TRANSLATE_MODEL=meta/muse-glimmer-30b,poolside/laguna-s-2.1
# Optional local override for the explicit concrete reviewer chain used by
# independent EN↔VI translation QA. It must not overlap ANYROUTER_TRANSLATE_MODEL
# or ANYROUTER_ENGLISH_TRANSLATE_MODEL; translation QA fails closed rather than
# silently falling back to a generator.
# ANYROUTER_REVIEW_MODEL=z-ai/glm-4.6,stealth/space-bunny-alpha
# Jev System One model (POST /api/v1/systemone, BYOK-only via
# Dashboard → BYOK → TypeSafe). Optional override, defaults to typesafe/jev.
# Score and review gates try it first; chat models are the backup.
# ANYROUTER_JEV_MODEL=typesafe/jev

# --- JEV review panel on the scoring path (#203) ---
# Off unless JEV_PANEL_ENABLED is truthy. With it unset, scoring is unchanged.
# The two judges must name concrete models from DIFFERENT vendor families; a
# duplicate model or a same-family pair is refused before any judge runs, and a
# router alias (anyrouter/auto) is not accepted as a model. The panel can only
# lower relevance, never raise it, and the existing relevance gate still owns
# the publish decision. See apps/web/worker/jev-panel/README.md.
# JEV_PANEL_ENABLED=1
# JEV_PANEL_RELEVANCE_MODEL=openai/gpt-5.2
# JEV_PANEL_SOURCE_QUALITY_MODEL=anthropic/claude-opus-4-5
# Optional third scoring judge; must be a model no other seat uses.
# JEV_PANEL_SAFETY_MODEL=google/gemini-3-pro
# Translation panel only (fidelity + safety), used by suggestion review.
# JEV_PANEL_TRANSLATION_FIDELITY_MODEL=
# JEV_PANEL_QUORUM=2
# JEV_PANEL_DEBATE=0
# JEV_PANEL_FAIL_MODE=open
# JEV_PANEL_BUDGET_MS=40000
# JEV_PANEL_APPLY_CATEGORY=0

# --- Telegram alerts ---
# Chat ids may live in wrangler.toml [vars] instead of a secret.
# TELEGRAM_CHAT_ID was the old Vietnamese name.
TELEGRAM_BOT_TOKEN=
TELEGRAM_VI_CHAT_ID=
TELEGRAM_EN_CHAT_ID=

# --- Facebook Page (optional) ---
# One install, one Page. Leave these empty to keep the channel off.
# Nothing here is committed with a real value. FACEBOOK_APP_ID stays in
# .env.local: `pnpm facebook:mint` reads it there. Do not copy it into
# wrangler.toml. FACEBOOK_APP_SECRET is local only: `--sync` and
# `pnpm sync-env` never upload it.
# Mint: pnpm facebook:mint --user-token <short-lived user token>
# The user token needs pages_show_list, pages_read_engagement, pages_manage_posts.
FACEBOOK_PAGE_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional. Unset uses Graph v26.0.
# FACEBOOK_GRAPH_VERSION=v26.0
# Optional. Links on the Page. Unset uses SITE_URL in apps/web/src/lib/site.ts.
# SITE_URL=https://example.com

# --- Threads (not posted yet) ---
# Off until both are set. No user id is committed. The hourly notifier does
# not call the Threads API and does not mint a token. A later poster sends
# one daily edition as its own thread: text plus the aidr.today day card,
# never a publisher image. Separate from the Facebook Page.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Admin API (POST /api/admin/*) ---
NEWS_ADMIN_TOKEN=
# Optional comma-separated Clerk user ids allowed as admins
NEWS_ADMIN_USER_IDS=

# --- Optional ---
NEWS_UNSUBSCRIBE_SECRET=
NOTIFY_WEBHOOK_URL=
# Owner address for new-subscriber Telegram+email pings (email skipped when empty).
OWNER_NOTIFY_EMAIL=
# Sentry-compatible DSN (Bugsink). Worker secret. Empty skips failure alerts.
SENTRY_DSN=
# Owner Telegram chat id for health-alert DMs and the 09:00 daily summary
# (sent with TELEGRAM_BOT_TOKEN). Empty disables owner DMs.
# TELEGRAM_OWNER_CHAT_ID=
# Fine-grained GitHub PAT, Issues: read/write on duyet/aidr + duyet/anyrouter.
# Files/comments `aidr-alert` issues for health alerts. Empty disables it.
# GITHUB_ALERT_TOKEN=

# --- Analytics (public GA4 client id, not a secret) ---
VITE_MEASUREMENT_ID=G-HXJPPQVYQN
# GA4 Data API service account for the /data Audience tab (page views, DAU,
# MAU). The Worker cannot read the browser's GA4 events back, so it pulls the
# property server-side on a daily schedule and stores one snapshot in D1.
#   GA4_PROPERTY_ID      numeric id, or `properties/123456` (public config —
#                         safe as a wrangler.toml [vars] entry)
#   GA4_SERVICE_ACCOUNT_JSON  the whole downloaded key file, JSON-encoded, as
#                         ONE line. Give the service account the "Viewer" role
#                         on the GA4 property and nothing else. Without it the
#                         Audience tab reports "Unavailable", never zero.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# --- Cloudflare (local / CI; do not commit real values) ---
# Used by `pnpm sync-env` → GitHub Actions + wrangler auth.
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=

# --- YouTube Data API (headless daily-video upload) ---
# Used by .agents/skills/aidr-youtube-upload/bin/yt-upload-api.mjs. OAuth client type
# "Desktop app"; mint the refresh token once with bin/yt-oauth.mjs (scopes youtube.upload +
# youtube, channel owner's account). Leave empty to fall back to the Chrome uploader.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
