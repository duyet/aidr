# aidr / AI;DR — copy to .env / .env.local / .env.production.local
# Keys only here. Put real values in gitignored env files, then:
#   pnpm --filter @aidr/web exec tsx scripts/sync-secrets.ts
# or: wrangler secret put <KEY> (from apps/web)

# --- Client (Vite build-time) ---
VITE_CLERK_PUBLISHABLE_KEY=

# --- LLM (AnyRouter) ---
# ANYROUTER_BASE_URL may live in wrangler.toml [vars] instead of a secret.
ANYROUTER_API_KEY=
ANYROUTER_BASE_URL=

# --- ClickHouse (story archive / analytics) ---
CLICKHOUSE_HOST=
CLICKHOUSE_NEWS_USER=
CLICKHOUSE_NEWS_PASSWORD=
CLICKHOUSE_DATABASE=

# --- Telegram alerts ---
# TELEGRAM_CHAT_ID may live in wrangler.toml [vars] instead of a secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Admin API (POST /api/admin/*) ---
NEWS_ADMIN_TOKEN=
# Optional comma-separated Clerk user ids allowed as admins
NEWS_ADMIN_USER_IDS=

# --- Optional ---
NEWS_UNSUBSCRIBE_SECRET=
NOTIFY_WEBHOOK_URL=

# --- Cloudflare (local / CI only; do not commit real values) ---
# Prefer apps/web/wrangler.toml account_id for deploys. Put tokens in .env.local:
# CLOUDFLARE_API_TOKEN=
